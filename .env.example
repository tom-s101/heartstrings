# Frontend (Vite) — safe to expose, these are public keys
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# NOTE: the ANTHROPIC_API_KEY is NOT here on purpose.
# It lives only as a Supabase Edge Function secret (server-side):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
